#!/usr/bin/env bash
# ai-merge-resolve — self-test gate (PASS/FAIL).
# Verifies the built CLI parses and `--help` is served. Requires node + build.
# Deliberately exit-0 on PASS so upstream vendored repos get a clean gate.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== ai-merge-resolve check: start =="
fail=0

if ! node --check dist/cli.js 2>/dev/null; then
  echo "FAIL: dist/cli.js not built or syntax error (run \`npm run build\` first)"
  exit 1
fi

set +e
# --help must not require a real API key; inject a dummy key so the OpenAI
# client constructs (index.js instantiates at module load). Never a real secret.
help_out="$(OPENAI_API_KEY=sk-dummy-check node dist/cli.js --help 2>&1)"
rc=$?
set -e

if [ "$rc" -ne 0 ]; then
  echo "FAIL: bin/run --help exited rc=$rc output: $help_out"
  fail=1
elif ! echo "$help_out" | grep -qiE 'usage|spec|resolve|merge'; then
  echo "FAIL: --help did not describe the resolver"
  fail=1
else
  echo "OK: CLI --help served"
fi

if [ "$fail" -eq 1 ]; then
  echo "== ai-merge-resolve check: FAIL =="; exit 1
fi
echo "== ai-merge-resolve check: PASS =="
exit 0